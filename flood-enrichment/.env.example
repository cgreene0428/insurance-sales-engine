# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# National Flood Data API key (plan must include the `property` + `elevation` add-ons)
NFD_API_KEY=

# HubSpot Private App token (legacy API keys are deprecated)
HUBSPOT_ACCESS_TOKEN=

# HubSpot app Client secret — used to validate X-HubSpot-Signature-V3 webhooks
HUBSPOT_WEBHOOK_SECRET=

# Argenia portal login
ARGENIA_USERNAME=
ARGENIA_PASSWORD=
